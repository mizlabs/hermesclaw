# Hermes (Planner — no execution privileges)
HERMES_MODEL_ENDPOINT=http://localhost:11434/v1
HERMES_MODEL_NAME=llama3.2
HERMES_CLI_PATH=hermes

# OpenClaw (Executor — sandboxed)
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_WORKSPACE=./workspace
OPENCLAW_CLI_PATH=openclaw

# Security (safe defaults — do not change unless you understand the risk)
NETWORK_ENABLED=false
SAFETY_CONFIRM_DESTRUCTIVE=true
AUTO_APPROVE=false
DRY_RUN=false
WORKSPACE_ROOT=./workspace
EXECUTION_TIMEOUT_SEC=300

PLAN_SIGNING_SECRET=change-this-to-a-long-random-secret
TOKEN_TTL_SEC=300
REQUIRE_SIGNED_TOKEN=true

# Orchestrator
LOG_LEVEL=INFO
MAX_RETRY_ATTEMPTS=3
HERMES_MOCK_MODE=true
MEMORY_DB_PATH=./data/memory.db
AUDIT_LOG_PATH=./logs/audit.jsonl

# API (binds localhost only — never expose to network without auth)
API_HOST=127.0.0.1
API_PORT=8000
