# =============================================================================
# HermesClaw — environment template (safe to commit)
# =============================================================================
# Copy to project root, then fill secrets locally:
#   cp config/.env.example .env
#
# NEVER commit .env — it is gitignored. Only this file belongs in git.
# Before push, run: ./scripts/pre_push_check.sh
# =============================================================================

# --- Hermes planner (CLI only — no execution privileges) -------------------
# HermesClaw invokes: hermes -z "<prompt>"
# Model/provider/API keys live in ~/.hermes/config.yaml and ~/.hermes/.env
# Change with: hermes model | hermes config set | hermes onboard
HERMES_CLI_PATH=hermes
# Auto-resolved if ~/.local/bin/hermes exists (standard installer path)
HERMES_MOCK_MODE=true
# Set false when Hermes CLI is installed and configured

# Reserved (not wired to hermes -z today — use ~/.hermes/ for real API config)
HERMES_MODEL_ENDPOINT=http://localhost:11434/v1
HERMES_MODEL_NAME=llama3.2

# --- OpenClaw executor (sandboxed) -------------------------------------------
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_GATEWAY_TOKEN=
# From: openclaw config get gateway.auth.token  (after ./scripts/setup_openclaw.sh)
OPENCLAW_GATEWAY_SESSION_KEY=main
OPENCLAW_GATEWAY_TIMEOUT_SEC=30
OPENCLAW_CLI_PATH=openclaw
OPENCLAW_WORKSPACE=./workspace

# auto   = gateway when token set and reachable, else local fallback
# local  = always execute in-process (no HTTP)
# gateway = require OpenClaw gateway (fail if unreachable)
OPENCLAW_EXECUTION_MODE=auto

# When HTTP /tools/invoke returns 404 (OpenClaw 2026.5.x), use openclaw agent --json
OPENCLAW_AGENT_EXECUTION=true

# --- Security (safe defaults — change only if you understand the risk) -------
NETWORK_ENABLED=false
SAFETY_CONFIRM_DESTRUCTIVE=true
AUTO_APPROVE=false
DRY_RUN=false
WORKSPACE_ROOT=./workspace
EXECUTION_TIMEOUT_SEC=300

# Signing — REQUIRED for real runs. Generate locally, never commit the value:
#   python -c "import secrets; print(secrets.token_hex(32))"
PLAN_SIGNING_SECRET=
TOKEN_TTL_SEC=300
REQUIRE_SIGNED_TOKEN=true

# --- Orchestrator ------------------------------------------------------------
LOG_LEVEL=INFO
MAX_RETRY_ATTEMPTS=3
MEMORY_DB_PATH=./data/memory.db
AUDIT_LOG_PATH=./logs/audit.jsonl

# --- API (localhost only — do not expose without auth) -----------------------
API_HOST=127.0.0.1
API_PORT=8000
